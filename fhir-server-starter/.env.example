# True per-environment secrets only — checked-in behavior config lives in
# configs/config.yaml + configs/cache.yaml instead.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# ── Redis ───────────────────────────────────────────────────────────────
# Only required when configs/config.yaml's redis.enabled is true (the
# default) — omit entirely when running with redis.enabled: false.
REDIS_URL=redis://localhost:6379

# ── Auth (optional) ─────────────────────────────────────────────────────
# Only required if you wire Depends(get_current_user) onto a route — see
# app/auth/dependencies.py. Leave unset if you don't need auth at all.
# JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# JWT_ISSUER=https://your-idp.example.com
