{
  "info": {
    "_postman_id": "c1f8a840-798b-4bf1-a5fa-fhir-org-search",
    "name": "FHIR R4 Organization API & Search",
    "description": "Comprehensive Postman test collection for FHIR R4 Organization resource and all official search parameters from https://www.hl7.org/fhir/R4/organization.html#search, including :missing modifiers, full schema creation, and dual content negotiation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "rootOrgId",
      "value": "190000",
      "type": "string"
    },
    {
      "key": "childOrgId",
      "value": "190001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Setup & Create Organizations",
      "item": [
        {
          "name": "Create Root Organization (Full FHIR R4 Structure)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "var orgId = json.id || json.organization_id;",
                  "if (orgId) {",
                  "    pm.collectionVariables.set('rootOrgId', orgId.toString());",
                  "    pm.environment.set('rootOrgId', orgId.toString());",
                  "    console.log('Saved rootOrgId:', orgId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/fhir+json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Organization\",\n  \"name\": \"St. Jude Children's Research Hospital\",\n  \"active\": true,\n  \"alias\": [\n    \"St. Jude\",\n    \"SJCRH\"\n  ],\n  \"identifier\": [\n    {\n      \"use\": \"official\",\n      \"type\": {\n        \"coding\": [\n          {\n            \"system\": \"http://terminology.hl7.org/CodeSystem/v2-0203\",\n            \"code\": \"PRN\",\n            \"display\": \"Provider number\"\n          }\n        ],\n        \"text\": \"Provider number\"\n      },\n      \"system\": \"http://hl7.org/fhir/sid/us-npi\",\n      \"value\": \"9876543210\"\n    }\n  ],\n  \"type\": [\n    {\n      \"coding\": [\n        {\n          \"system\": \"http://terminology.hl7.org/CodeSystem/organization-type\",\n          \"code\": \"prov\",\n          \"display\": \"Healthcare Provider\"\n        }\n      ],\n      \"text\": \"Healthcare Provider\"\n    }\n  ],\n  \"telecom\": [\n    {\n      \"system\": \"phone\",\n      \"value\": \"+1-800-822-6344\",\n      \"use\": \"work\",\n      \"rank\": 1\n    }\n  ],\n  \"address\": [\n    {\n      \"use\": \"work\",\n      \"type\": \"both\",\n      \"text\": \"262 Danny Thomas Place, Memphis, TN 38105\",\n      \"line\": [\n        \"262 Danny Thomas Place\"\n      ],\n      \"city\": \"Memphis\",\n      \"district\": \"Shelby\",\n      \"state\": \"TN\",\n      \"postal_code\": \"38105\",\n      \"country\": \"USA\"\n    }\n  ],\n  \"part_of\": null,\n  \"contact\": [\n    {\n      \"purpose\": {\n        \"coding\": [\n          {\n            \"system\": \"http://terminology.hl7.org/CodeSystem/contactentity-type\",\n            \"code\": \"ADMIN\",\n            \"display\": \"Administrative\"\n          }\n        ],\n        \"text\": \"Administrative Contact\"\n      },\n      \"name\": {\n        \"use\": \"official\",\n        \"text\": \"Dr. James Downing\",\n        \"family\": \"Downing\",\n        \"given\": [\n          \"James\"\n        ],\n        \"prefix\": [\n          \"Dr.\"\n        ]\n      },\n      \"telecom\": [\n        {\n          \"system\": \"email\",\n          \"value\": \"james.downing@stjude.org\",\n          \"use\": \"work\"\n        }\n      ],\n      \"address\": {\n        \"line\": [\n          \"262 Danny Thomas Place, Administration\"\n        ],\n        \"city\": \"Memphis\",\n        \"state\": \"TN\",\n        \"postal_code\": \"38105\"\n      }\n    }\n  ],\n  \"endpoint\": [\n    {\n      \"reference\": \"Endpoint/ep-stjude-1\",\n      \"display\": \"St. Jude FHIR API Gateway\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations",
                ""
              ]
            }
          }
        },
        {
          "name": "Create Child Organization (Linked via part_of)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "var orgId = json.id || json.organization_id;",
                  "if (orgId) {",
                  "    pm.collectionVariables.set('childOrgId', orgId.toString());",
                  "    pm.environment.set('childOrgId', orgId.toString());",
                  "    console.log('Saved childOrgId:', orgId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/fhir+json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Organization\",\n  \"name\": \"St. Jude Pediatric Oncology Wing\",\n  \"active\": false,\n  \"alias\": [\n    \"Pediatric Oncology\"\n  ],\n  \"identifier\": [\n    {\n      \"use\": \"secondary\",\n      \"system\": \"urn:stjude:dept\",\n      \"value\": \"DEPT-ONC-01\"\n    }\n  ],\n  \"type\": [\n    {\n      \"coding\": [\n        {\n          \"system\": \"http://terminology.hl7.org/CodeSystem/organization-type\",\n          \"code\": \"dept\",\n          \"display\": \"Hospital Department\"\n        }\n      ]\n    }\n  ],\n  \"telecom\": [\n    {\n      \"system\": \"phone\",\n      \"value\": \"+1-800-822-0000\",\n      \"use\": \"work\"\n    }\n  ],\n  \"address\": [\n    {\n      \"use\": \"billing\",\n      \"line\": [\n        \"262 Danny Thomas Place, Pavilion B\"\n      ],\n      \"city\": \"Memphis\",\n      \"state\": \"TN\",\n      \"postal_code\": \"38105\",\n      \"country\": \"USA\"\n    }\n  ],\n  \"part_of\": \"{{rootOrgId}}\",\n  \"contact\": [],\n  \"endpoint\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations",
                ""
              ]
            }
          }
        }
      ]
